#!/bin/bash

source "${THEME_HOOK_LIB:-$HOME/.config/omarchy/hooks/theme-set.lib.sh}"

hooks_dir="$HOME/.config/omarchy/hooks/theme-set.d"

# Omarchy 4's omarchy-hook runs theme-set and then every file in theme-set.d
# itself. Dispatching the hooklettes here as well would run each of them twice,
# so they are only dispatched when omarchy-hook did not (Omarchy 3), or when
# theme-set was started by hand.
omarchy_hook_dispatches_hooklettes() {
    local hook_bin parent_cmdline
    hook_bin=$(command -v omarchy-hook 2>/dev/null) || hook_bin="/usr/share/omarchy/bin/omarchy-hook"
    [[ -r $hook_bin ]] || return 1
    grep -q 'HOOK_DIR' "$hook_bin" || return 1

    parent_cmdline=$(tr '\0' ' ' < "/proc/$PPID/cmdline" 2>/dev/null) || return 1
    [[ $parent_cmdline == *omarchy-hook* ]]
}

run_hooklettes() {
    local hook
    for hook in "$hooks_dir"/*.sh; do
        if [[ -f "$hook" && -x "$hook" ]]; then
            if ! "$hook" "$@"; then
                warning "Hook $(basename "$hook") failed!"
            fi
        fi
    done
}

# Start every run with an empty restart list; hooklettes append to it and
# 99-restart.sh reports it once they have all run.
: > "$restart_file"

if [[ -d "$hooks_dir" ]] && ! omarchy_hook_dispatches_hooklettes; then
    run_hooklettes "$@"
fi
